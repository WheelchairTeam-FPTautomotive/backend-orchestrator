# ------------------------------------------------------------------------------
# KMS Backend Orchestrator — Environment Template (locked deploy)
# ------------------------------------------------------------------------------
# Copy to .env and fill secrets. Same-box EC2: Core on 127.0.0.1:8001.
# Docker Compose override sets CORE_AI_URL to http://kms-core-ai:8001/...
# STM requires a single Uvicorn worker (do not raise --workers above 1).
# ------------------------------------------------------------------------------

# Application identity
APP_NAME="KMS Cockpit API Gateway Orchestrator"
APP_VERSION="1.0.0"

# Uvicorn server binding
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
# STM coherence: keep workers=1 (Compose/systemd command, not only this file)
# UVICORN_WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Downstream KMS Core AI RAG engine
# Same-box EC2 / local processes:
CORE_AI_URL=http://127.0.0.1:8001/api/v1/search
# Docker Compose (service DNS) — set automatically in docker-compose.yml:
# CORE_AI_URL=http://kms-core-ai:8001/api/v1/search

# Language-aware in-process query cache (#16). TTL seconds; 0 disables.
# Bypass per-request: header X-Cache-Bypass: 1
QUERY_CACHE_TTL_S=60

# Optional OpenAI key (not required for Bedrock Nemotron / Edge+VieNeu path)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Voice pipeline (src/services/voice_utils.py)
# Race: Edge (prefer / latency) + VieNeu (quality fallback). Cockpit TTS last.
# ------------------------------------------------------------------------------
VIENEU_TTS_URL=http://127.0.0.1:8022/v1/audio/speech
VIENEU_VOICE=truc_ly
VIENEU_TTS_TIMEOUT_S=20
EDGE_TTS_TIMEOUT_S=12
TTS_RACE_GEMINI=0
GEMINI_API_KEY=

# STT: Groq Whisper (multipart /copilot/voice-query)
# https://console.groq.com/keys
GROQ_API_KEY=

# AWS region (STT/TTS extras / shared tooling). Align with Core: ap-southeast-2.
AWS_REGION=ap-southeast-2
