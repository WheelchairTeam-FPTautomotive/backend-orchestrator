aws_region         = "us-east-1"
project_name       = "backend-orchestrator"
environment        = "dev"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

container_port = 8000
image_tag      = "latest"
desired_count  = 1
fargate_cpu    = 256
fargate_memory = 512

log_level   = "INFO"
core_ai_url = "http://CHANGE_ME:8001/api/v1/search"

# Replace with the real key. This value is stored in AWS Secrets Manager.
openai_api_key = "sk-..."
