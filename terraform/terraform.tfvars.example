# Locked v1 defaults (Acc→Lat→Budget): one EC2 + manuals S3; no AOSS/ECS/SageMaker.
aws_region   = "ap-southeast-2"
project_name = "backend-orchestrator"
environment  = "dev"

enable_ec2            = true
enable_manuals_bucket = true
enable_ecs            = false
enable_aoss           = false
deploy_sagemaker_model = false

ec2_instance_type = "t3.xlarge"
# REQUIRED before apply — EC2 SSH key pair NAME in ap-southeast-2 (not Access Key ID):
# 1) Console: EC2 → Key pairs → Create (RSA, .pem)  OR  aws ec2 create-key-pair ...
# 2) Set the name here; keep the .pem for Ansible SSH
# ec2_key_name     = "kms-ec2"
# ssh_ingress_cidr = "x.x.x.x/32"
# AWS API creds: aws login → aws configure export-credentials --format env (shell only — NOT here).
# If iam:CreateRole is blocked by hackathon IAM:
# create_ec2_instance_profile = false
# existing_ec2_instance_profile_name = "YourInstanceProfile"

bedrock_model_id = "nvidia.nemotron-super-3-120b"
core_ai_url      = "http://127.0.0.1:8001/api/v1/search"

# manuals_bucket_name = "your-unique-manuals-bucket-name"

# --- Legacy (keep false for v1) ---
# enable_ecs  = true
# enable_aoss = true
# openai_api_key = "sk-..."
# sagemaker_model_id = "Qwen/Qwen2.5-7B-Instruct-AWQ"
