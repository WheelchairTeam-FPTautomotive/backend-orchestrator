aws_region         = "us-east-1"
project_name       = "backend-orchestrator"
environment        = "dev"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

container_port = 8000
image_tag      = "latest"
desired_count  = 1
fargate_cpu    = 256
fargate_memory = 512

log_level   = "INFO"
core_ai_url = "http://CHANGE_ME:8001/api/v1/search"

# Replace with the real key. This value is stored in AWS Secrets Manager.
openai_api_key = "sk-..."

# --- SageMaker GPU (issues #12 / #17) — keep deploy_sagemaker_model=false until mentor IAM ---
# Local Ollama freeze: qwen2.5:7b-instruct ↔ cloud HF AWQ id (behavior parity).
sagemaker_model_id              = "Qwen/Qwen2.5-7B-Instruct-AWQ"
sagemaker_instance_type         = "ml.g4dn.xlarge"
sagemaker_inference_ami_version = "al2-ami-sagemaker-inference-gpu-3-1" # required for cu130 images
deploy_sagemaker_model          = false
# Hackathon users lack iam:CreateRole — set a pre-existing role ARN before apply:
# sagemaker_execution_role_arn  = "arn:aws:iam::ACCOUNT:role/YourSageMakerExecutionRole"
