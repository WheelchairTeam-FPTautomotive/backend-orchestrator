[
  {
    "name": "{{ container_name }}",
    "image": "{{ ecr_repository_url }}:{{ image_tag }}",
    "essential": true,
    "cpu": {{ container_cpu | int }},
    "memory": {{ container_memory | int }},
    "portMappings": [
      {
        "containerPort": {{ container_port | int }},
        "hostPort": {{ container_port | int }},
        "protocol": "tcp"
      }
    ],
    "environment": [
      {% for key, value in ecs_app_env.items() %}
      {
        "name": "{{ key }}",
        "value": "{{ value }}"
      }{{ "," if not loop.last else "" }}
      {% endfor %}
    ],
    "secrets": [
      {% for key, value in ecs_app_secret_arns.items() %}
      {
        "name": "{{ key }}",
        "valueFrom": "{{ value }}"
      }{{ "," if not loop.last else "" }}
      {% endfor %}
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "{{ ecs_log_group_name }}",
        "awslogs-region": "{{ aws_region }}",
        "awslogs-stream-prefix": "ecs"
      }
    },
    "healthCheck": {
      "command": [
        "CMD-SHELL",
        "python -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:{{ container_port }}{{ health_check_path }}\")' || exit 1"
      ],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 10
    },
    "readonlyRootFilesystem": false
  }
]
