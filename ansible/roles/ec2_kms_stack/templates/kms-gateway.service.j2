[Unit]
Description=KMS Gateway Orchestrator
After=network.target kms-core.service
Wants=kms-core.service

[Service]
Type=simple
WorkingDirectory={{ kms_gateway_dir }}
EnvironmentFile={{ kms_env_dir }}/gateway.env
# STM: workers must stay 1
ExecStart=/usr/bin/env python3 -m uvicorn main:app --app-dir src --host 0.0.0.0 --port {{ kms_gateway_port }} --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
