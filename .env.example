# IMPORTANT: Rename this file to `.env.example` (with a leading dot).
# The automated tooling blocked creation of a file named `.env.example`
# directly due to a built-in env-file permission guard.
#
# ------------------------------------------------------------------------------
# KMS Backend Orchestrator — Environment Template
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in the real values before running the service.
# docker-compose.yml loads these variables automatically.
# ------------------------------------------------------------------------------

# Application identity
APP_NAME="KMS Cockpit API Gateway Orchestrator"
APP_VERSION="1.0.0"

# Uvicorn server binding
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Downstream KMS Core AI RAG engine.
# When running inside Docker Compose, use the service name as the host.
# When running locally, point to http://localhost:8001/api/v1/search.
CORE_AI_URL=http://kms-core-ai:8001/api/v1/search

# --- START MODIFICATION ---
# Language-aware in-process query cache (issue #16). TTL seconds; 0 disables.
# Cap is fixed at maxsize=1000 (cachetools.TTLCache). Bypass per-request via
# header X-Cache-Bypass: 1 (golden / benchmark scripts).
QUERY_CACHE_TTL_S=60
# --- END MODIFICATION ---

# External AI/embedding provider keys (used by kms-core-ai; included here so
# a single .env can feed both services in docker-compose).
OPENAI_API_KEY=

# --- START MODIFICATION ---
# Voice pipeline (backend-orchestrator/src/services/voice_utils.py)
# TTS: Gemini multimodal audio (gateway returns audio_base64 on /copilot/query)
# Get a key: https://aistudio.google.com/apikey
# Comma-separated keys supported for rotation.
GEMINI_API_KEY=

# STT: Groq Whisper (multipart /copilot/voice-query)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# --- END MODIFICATION ---
